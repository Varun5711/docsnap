{
  "manifest_version": 3,
  "name": "DocSnap",
  "description": "Verify claims from the web with cryptographically verifiable evidence.",
  "version": "0.2.0",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "tabs", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://localhost:8080/*", "https://*/*", "http://*/*"]
}
