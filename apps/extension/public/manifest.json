{
  "manifest_version": 3,
  "name": "DocSnap",
  "description": "Capture web screenshots and claims for Flare-certified evidence.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "tabs", "scripting"],
  "host_permissions": ["http://localhost:8080/*", "https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"]
    }
  ]
}
