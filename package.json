{
  "name": "docsnap",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/web",
    "apps/extension"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:extension": "bun run --cwd apps/extension dev",
    "dev:api": "bash -c 'set -a && source .env && set +a && cd services/api && air'",
    "build:web": "bun run --cwd apps/web build",
    "build:extension": "bun run --cwd apps/extension build",
    "lint:web": "bun run --cwd apps/web lint",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "typecheck:extension": "bun run --cwd apps/extension typecheck"
  }
}
