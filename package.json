{
  "name": "docsnap",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/extension"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:extension": "npm --workspace apps/extension run dev",
    "build:web": "npm --workspace apps/web run build",
    "build:extension": "npm --workspace apps/extension run build",
    "lint:web": "npm --workspace apps/web run lint",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "typecheck:extension": "npm --workspace apps/extension run typecheck"
  }
}

